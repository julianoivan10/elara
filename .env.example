# ---------------------------------------------------------------- core
# PostgreSQL connection used by the running app.
#
# Local (docker compose):
#   postgresql://elara:elara@localhost:55432/elara?schema=public
#
# Vercel + Supabase: use the *pooler* connection string (Supabase dashboard →
# Connect → Transaction pooler), NOT the direct db.<ref>.supabase.co host. The
# direct host is IPv6-only and Vercel functions cannot reach it, so every
# database query — including login — fails. Keep both parameters: pgbouncer=true
# is required by the transaction pooler; connection_limit caps each instance.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://elara:elara@localhost:55432/elara?schema=public"

# Non-pooled connection, used only by `prisma migrate`. Locally the same as
# DATABASE_URL. For Supabase, the session pooler (port 5432 on the pooler host)
# works from anywhere; the direct db.<ref>.supabase.co host needs IPv6.
DIRECT_URL="postgresql://elara:elara@localhost:55432/elara?schema=public"

# Public origin, used for links in verification / reset emails and to build the
# Google OAuth callback URL (APP_URL + /api/auth/google/callback). On Vercel it
# falls back to the project's production domain when unset, but set it
# explicitly there: https://elara-alpha-ten.vercel.app
APP_URL="http://localhost:3000"

# 32+ random bytes. Signs the short-lived Google sign-in state cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me"

# ---------------------------------------------------------------- optional integrations
# Every integration below is optional. ELARA degrades gracefully without them:
# AI features return a clear "not configured" message, and emails are logged to the
# server console instead of being delivered.

# Google Gemini — powers the AI career assistant. Server-side only: never
# prefix it with NEXT_PUBLIC_. The model is pinned in src/server/ai/gemini.ts.
GEMINI_API_KEY=""

# Google sign-in — OAuth client of type "Web application" in Google Cloud
# Console. Both or neither: the "Continue with Google" button only appears when
# both are set. Server-side only: never prefix either with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Live job sync. The job boards ELARA reads (Ashby, Greenhouse, Lever) are
# public APIs and need no keys. This secret protects the scheduled sync route:
# set it on Vercel and Vercel Cron sends it automatically. 16+ random chars.
CRON_SECRET=""

# Adzuna — optional job aggregator. Off unless both are set. Adzuna's terms
# require "Jobs by Adzuna" attribution (shown on every Adzuna listing) and may
# require a licence for commercial use after a 14-day trial.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Resend — transactional email (verification, password reset).
RESEND_API_KEY=""
EMAIL_FROM="ELARA <onboarding@resend.dev>"
