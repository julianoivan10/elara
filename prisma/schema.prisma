// ELARA — career workspace
//
// Data model notes:
//  * Resume content is a *projection* of the Career Profile, not a copy. A Resume owns
//    ordering / visibility / overrides via ResumeSection.config, while the facts live once
//    on the Profile, so every resume stays current when the profile changes.
//  * Templates are code (src/features/resume/templates), not rows. A ResumeTemplate table
//    would carry no data the code registry does not already own.

generator client {
  provider = "prisma-client-js"

  // Load relations with one SQL statement (LATERAL joins) instead of one
  // query per relation. Measured: the full profile went from 10 sequential
  // queries inside a transaction to 1, and every query costs a network round
  // trip to the database, so this is the difference between ~4.5s and well
  // under a second per page in production.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"

  // DATABASE_URL is what the running app uses. On a serverless host it should
  // be a *pooled* connection (Supabase's Supavisor on port 6543, with
  // ?pgbouncer=true&connection_limit=5), because each function instance opens
  // its own connections and direct ones run out fast. The limit is above 1
  // because a Vercel instance serves concurrent requests (Fluid compute).
  url = env("DATABASE_URL")

  // DIRECT_URL bypasses the pooler and is used only by `prisma migrate` and
  // `prisma db push`. Migrations need a real session, which a transaction
  // pooler cannot give them. Locally the two are usually the same value.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// Null for accounts that have only ever signed in with a provider such as
  /// Google. Such a user can add a password later through password reset.
  passwordHash    String?
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile      Profile?
  accounts     Account[]
  sessions     Session[]
  tokens       VerificationToken[]
  resumes      Resume[]
  savedJobs    SavedJob[]
  applications Application[]
  aiUsage      AiUsage[]

  @@index([createdAt])
}

/// An external identity linked to a user: one row per provider login.
///
/// Email/password stays on User itself (it predates this table, and every
/// existing account uses it). Providers are rows here, so adding another one
/// later is a new `provider` value, not a schema change.
model Account {
  id                String   @id @default(cuid())
  userId            String
  /// "google"
  provider          String
  /// The provider's stable subject identifier (OIDC `sub`). Never the email:
  /// an address can change hands, a subject cannot.
  providerAccountId String
  /// The provider's email at the time of linking, for display and support.
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  type       TokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------------------------------------------------------------- career profile

model Profile {
  id       String @id @default(cuid())
  userId   String @unique
  fullName String

  headline   String?
  summary    String?
  location   String?
  phone      String?
  website    String?
  avatarUrl  String?
  openToWork Boolean @default(true)

  // Job preferences. Used to filter and rank real listings; all optional, and
  // an empty list means "no preference", never "none of these".
  targetRoles              String[]         @default([])
  preferredLocationTypes   LocationType[]   @default([])
  preferredEmploymentTypes EmploymentType[] @default([])
  preferredLocations       String[]         @default([])
  desiredSalaryMin         Int?
  desiredSalaryCurrency    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  links          Link[]
  education      Education[]
  experience     Experience[]
  projects       Project[]
  skills         Skill[]
  certifications Certification[]
  languages      Language[]
  achievements   Achievement[]
}

model Link {
  id        String @id @default(cuid())
  profileId String
  label     String
  url       String
  sortIndex Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortIndex])
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  school      String
  degree      String?
  field       String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  grade       String?
  description String?
  sortIndex   Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortIndex])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

enum LocationType {
  ONSITE
  HYBRID
  REMOTE
}

model Experience {
  id             String         @id @default(cuid())
  profileId      String
  company        String
  role           String
  employmentType EmploymentType @default(FULL_TIME)
  locationType   LocationType   @default(ONSITE)
  location       String?
  startDate      DateTime?
  endDate        DateTime?
  current        Boolean        @default(false)
  summary        String?
  highlights     String[]
  skills         String[]
  sortIndex      Int            @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortIndex])
}

model Project {
  id           String    @id @default(cuid())
  profileId    String
  name         String
  role         String?
  description  String?
  highlights   String[]
  technologies String[]
  url          String?
  repoUrl      String?
  imageUrl     String?
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean   @default(false)
  featured     Boolean   @default(false)
  sortIndex    Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortIndex])
}

enum SkillLevel {
  FAMILIAR
  PROFICIENT
  ADVANCED
  EXPERT
}

model Skill {
  id        String     @id @default(cuid())
  profileId String
  name      String
  category  String?
  level     SkillLevel @default(PROFICIENT)
  sortIndex Int        @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId, sortIndex])
}

model Certification {
  id           String    @id @default(cuid())
  profileId    String
  name         String
  issuer       String?
  issueDate    DateTime?
  expiryDate   DateTime?
  credentialId String?
  url          String?
  sortIndex    Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortIndex])
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  FLUENT
  NATIVE
}

model Language {
  id          String              @id @default(cuid())
  profileId   String
  name        String
  proficiency LanguageProficiency @default(PROFESSIONAL)
  sortIndex   Int                 @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId, sortIndex])
}

model Achievement {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  description String?
  date        DateTime?
  sortIndex   Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortIndex])
}

// ---------------------------------------------------------------- resumes

enum ResumeSectionKind {
  HEADER
  SUMMARY
  EXPERIENCE
  EDUCATION
  PROJECTS
  SKILLS
  CERTIFICATIONS
  LANGUAGES
  ACHIEVEMENTS
  LINKS
}

model Resume {
  id          String  @id @default(cuid())
  userId      String
  title       String
  templateKey String  @default("editorial")
  accentKey   String  @default("cobalt")
  fontKey     String  @default("sans")
  density     String  @default("regular")
  targetJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJob    Job?            @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  sections     ResumeSection[]
  applications Application[]

  @@index([userId, updatedAt])
}

model ResumeSection {
  id        String            @id @default(cuid())
  resumeId  String
  kind      ResumeSectionKind
  title     String
  visible   Boolean           @default(true)
  sortIndex Int               @default(0)
  /// { includedIds: string[], overrides: Record<id, Partial<item>>, extras: item[], ...opts }
  config    Json              @default("{}")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, kind])
  @@index([resumeId, sortIndex])
}

// ---------------------------------------------------------------- jobs

enum Seniority {
  INTERNSHIP
  ENTRY
  MID
  SENIOR
  LEAD
}

enum SalaryPeriod {
  HOUR
  MONTH
  YEAR
}

/// Where live listings come from: one row per company job board (Ashby,
/// Greenhouse, Lever) or per aggregator search (Adzuna). Adding a company is a
/// new row, not a code change. Sync health is recorded here too.
model JobSource {
  id       String  @id @default(cuid())
  /// "ashby" | "greenhouse" | "lever" | "adzuna"
  provider String
  /// Board token / Lever site name, or "country|query" for an aggregator.
  key      String
  /// Company name (ATS boards) or a label (aggregator searches).
  name     String
  enabled  Boolean @default(true)

  lastSyncedAt  DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  lastJobCount  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@unique([provider, key])
}

model Job {
  id         String  @id @default(cuid())
  /// Provider key: "ashby" | "greenhouse" | "lever" | "adzuna" ("elara" for
  /// the local sample catalogue, which is never shown as a live listing).
  source     String  @default("elara")
  /// The provider's own job id. Unique per provider.
  externalId String?
  sourceId   String?

  title          String
  company        String
  companyDomain  String?
  companyLogoUrl String?
  department     String?

  /// Primary location as the provider wrote it; `locations` holds every one.
  location       String
  locations      String[] @default([])
  /// Lower-cased join of every location, for case-insensitive search.
  locationSearch String   @default("")

  // Unknown stays null: a posting that does not say "remote" is not assumed
  // to be on-site, and one that names no contract is not assumed full time.
  locationType   LocationType?
  employmentType EmploymentType?
  seniority      Seniority?

  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  salaryPeriod    SalaryPeriod?
  /// Salary converted to a yearly figure in its own currency, for filtering
  /// and sorting across hourly, monthly and yearly postings.
  salaryAnnualMin Int?
  salaryAnnualMax Int?

  summary              String
  /// Plain text converted from the provider's HTML at ingestion. Never
  /// rendered as HTML.
  description          String
  /// True when the provider only supplies an excerpt (aggregators).
  descriptionIsExcerpt Boolean  @default(false)
  requirements         String[]
  responsibilities     String[]
  /// Only skills whose names appear in the posting's own text.
  skills               String[]
  benefits             String[]

  /// The official application page.
  applyUrl          String
  /// The public posting page, when different from the application page.
  sourceUrl         String?
  applicationMethod ApplicationMethod @default(EXTERNAL_LINK)

  postedAt          DateTime?
  expiresAt         DateTime?
  providerUpdatedAt DateTime?

  // Freshness. A listing that disappears from its source is marked inactive,
  // not deleted, so saved jobs and applications keep their reference.
  isActive       Boolean  @default(true)
  /// "removed" (gone from the source) | "expired" | "duplicate"
  inactiveReason String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  /// company|title|location, normalised: finds the same job across providers.
  fingerprint String?
  /// Hash of the normalised content, so unchanged listings are not rewritten.
  contentHash String?

  isDemo Boolean @default(true)

  jobSource    JobSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  savedBy      SavedJob[]
  applications Application[]
  resumes      Resume[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([locationType, employmentType])
  @@index([isActive, isDemo, postedAt])
  @@index([sourceId])
  @@index([fingerprint])
  @@index([skills], type: Gin)
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- applications

enum ApplicationStatus {
  SAVED
  /// Resume, cover letter and answers are ready; not yet sent.
  PREPARED
  APPLIED
  SCREENING
  INTERVIEW
  ASSESSMENT
  OFFER
  REJECTED
}

/// How an application reaches the employer.
///   EXTERNAL_LINK: the person applies on the official page themselves.
///   ASSISTED:      ELARA prepares everything; the person still submits.
///   ATS:           submitted through a provider's official, authorised API.
///                  Not used until such an integration exists.
enum ApplicationMethod {
  EXTERNAL_LINK
  ASSISTED
  ATS
}

model Application {
  id       String            @id @default(cuid())
  userId   String
  jobId    String?
  company  String
  role     String
  location String?
  url      String?
  source   String?
  status   ApplicationStatus @default(SAVED)

  method         ApplicationMethod @default(EXTERNAL_LINK)
  /// Job provider the listing came from ("greenhouse", …), for ATS routing.
  provider       String?
  resumeId       String?
  /// The resume as it was when the application was marked applied, so later
  /// edits do not rewrite what was actually sent.
  resumeSnapshot Json?
  coverLetter    String?
  /// Prepared answers: [{ question, answer }].
  answers        Json?
  preparedAt     DateTime?

  appliedAt      DateTime?
  nextEventAt    DateTime?
  nextEventLabel String?
  sortIndex      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resume Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  notes  ApplicationNote[]
  events ApplicationEvent[]

  @@index([userId, status, sortIndex])
  @@index([userId, updatedAt])
  @@index([userId, jobId])
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  body          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

// ---------------------------------------------------------------- ai

enum AiTaskKind {
  IMPROVE_SUMMARY
  IMPROVE_HIGHLIGHT
  PROJECT_DESCRIPTION
  SUGGEST_SKILLS
  ANALYZE_JOB
  TAILOR_RESUME
  PROFILE_REVIEW
  COVER_LETTER
  JOB_MATCH
}

model AiUsage {
  id           String     @id @default(cuid())
  userId       String
  kind         AiTaskKind
  model        String
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  ok           Boolean    @default(true)
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
